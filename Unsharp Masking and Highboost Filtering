import cv2
import numpy as np

img_path = r"C:\Users\ngoc tuyet\Downloads\Fig0340(a)(dipxe_text).png"

img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)

img_f = img.astype(np.float32)

k = 5

kernel = np.ones((k, k), np.float32) / (k * k)

img_blur = cv2.filter2D(img_f, -1, kernel)

mask = img_f - img_blur

k_sharp = 1.0

sharp = img_f + k_sharp * mask

mask_display = cv2.normalize(mask, None, 0, 255, cv2.NORM_MINMAX)

# Chuyển ảnh sharpen về uint8 để hiển thị
sharp_display = np.clip(sharp, 0, 255).astype(np.uint8)

cv2.imshow('Original image', img)

cv2.imshow('Blur image', img_blur.astype(np.uint8))

cv2.imshow('Mask', mask_display)

cv2.imshow('Output image', sharp_display)

cv2.waitKey(0)

cv2.destroyAllWindows()
