import cv2
import numpy as np

img_path = r"C:\Users\ngoc tuyet\Downloads\Fig0237(a)(characters test pattern)_POST (1).png"
img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)

k = 3
a = k // 2

img_pad = np.pad(img, a, mode='constant', constant_values=0)

H, W = img.shape
img_out = np.zeros((H, W), np.uint8)

for y in range(H):
    for x in range(W):
        total = 0
        for s in range(-a, a+1):
            for t in range(-a, a+1):
                total += int(img_pad[y + a + s, x + a + t])
        img_out[y, x] = total // (k * k)

cv2.imshow('Original image', img)
cv2.imshow('Filtered image', img_out)

cv2.waitKey(0)
cv2.destroyAllWindows()3r
