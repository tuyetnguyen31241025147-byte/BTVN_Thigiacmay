import cv2
import numpy as np
import os

os.makedirs("output", exist_ok=True)

img = cv2.imread(r"C:\Users\ngoc tuyet\Downloads\Fig0651(a)(flower_no_compression).png")

img_norm = img.astype(np.float32) / 255.0
img_b = img_norm[:, :, 0]
img_g = img_norm[:, :, 1]
img_r = img_norm[:, :, 2]

C = 1 - img_r
M = 1 - img_g
Y = 1 - img_b

K = np.minimum(np.minimum(C, M), Y)

denom = 1 - K
denom[denom == 0] = 1e-6  # tránh lỗi chia 0

C = (C - K) / denom
M = (M - K) / denom
Y = (Y - K) / denom

img_cyan    = (C * 255).astype(np.uint8)
img_magenta = (M * 255).astype(np.uint8)
img_yellow  = (Y * 255).astype(np.uint8)
img_black   = (K * 255).astype(np.uint8)

cv2.imshow('Original Image', img)
cv2.imshow('Cyan Channel (CMYK)', img_cyan)
cv2.imshow('Magenta Channel (CMYK)', img_magenta)
cv2.imshow('Yellow Channel (CMYK)', img_yellow)
cv2.imshow('Black Channel (K)', img_black)

cv2.imwrite("output/12_cmyk_cyan.png", img_cyan)
cv2.imwrite("output/12_cmyk_magenta.png", img_magenta)
cv2.imwrite("output/12_cmyk_yellow.png", img_yellow)
cv2.imwrite("output/12_cmyk_black.png", img_black)

cv2.waitKey(0)
cv2.destroyAllWindows()
